# Edit the copy named .env before starting the optional application.
# Default HTTP access is local to the server. Bind to the server's LAN/Tailscale
# IP and set APP_ORIGIN to the complete browser URL to use another device.
APP_BIND=127.0.0.1
APP_PORT=7012
APP_ORIGIN=http://localhost:7012,http://127.0.0.1:7012
APP_UID=999
APP_GID=1000
OLLAMA_PORT=11435
MODEL_RAM_LIMIT=6g
MODEL_CPU_LIMIT=3.0
# Keep the single active model warm between requests. This uses RAM, not CPU.
MODEL_KEEP_ALIVE=30m
# Native Ollama requests for this kit's Qwen alias use the tested fast settings.
CPU_PROFILE_GUARD=1
# Reapply explicitly recorded Zarzysseus repairs only to matching upstream source.
ZARZYSSEUS_OVERLAY=1
APP_RAM_LIMIT=3g
APP_CPU_LIMIT=1.5
# Upstream image tags below can be replaced by tested immutable digests.
OLLAMA_IMAGE=ollama/ollama:latest
ODYSSEUS_IMAGE=ghcr.io/odysseus-dev/odysseus:latest

# Optional V11.1 Full profile: the RDNA3 inference service is NEVER auto-started.
# The GPU only works with a compatible AMD host; on ZimaOS CPU-only keep it stopped.
RDNA3_PORT=30000
RDNA3_GPU_INDEX=0
RDNA3_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# Optional alternative image digest after you independently validate the image:
# RDNA3_IMAGE=ghcr.io/amd-aim/sglang-radeon@sha256:...
